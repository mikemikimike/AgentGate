    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.9",
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^0.34.6",
    "node-pg-migrate": "^6.2.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0"

# ==============================================================================
# AgentGate - Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://user:pass@localhost:5432/agentgate
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=agentgate

# Security Proxy Gateway (Fastify)
PORT=8080
HOST=0.0.0.0
AGENTGATE_AUTH_TOKEN=dev-key-123
AG_DECISION_URL=http://localhost:9000
AG_DECISION_DEADLINE_MS=30000

# ML Decision Engine (Unsloth + Qwen 3.5 0.8B)
USE_UNSLOTH=1
DECISION_SERVER_PORT=9000
DECISION_MODEL_PATH=codeload/agentgate-qwen-0.8b
MODEL_PATH=./decision/qwen-decisions

# Operations Dashboard (Vite + React)
VITE_API_URL=http://localhost:8080
